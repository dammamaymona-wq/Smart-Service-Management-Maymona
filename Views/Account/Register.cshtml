@model SmartServiceManagement.Models.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "إنشاء حساب جديد"; Layout = null; }
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"]</title><link rel="stylesheet" href="~/Admin/assets/css/adminlte.css"/><link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet"/><style>body{font-family:Cairo,sans-serif;background:linear-gradient(135deg,#202b3e,#34465f);min-height:100vh;display:grid;place-items:center;padding:24px}.card{max-width:520px;width:100%;border:0;border-radius:18px;box-shadow:0 24px 55px #0004}.brand{color:#ed6b4d;font-weight:800;font-size:22px}.form-label{font-weight:700;font-size:13px}.btn-primary{background:#ed6b4d;border-color:#ed6b4d}.btn-primary:hover{background:#d95e43;border-color:#d95e43}</style></head><body><div class="card p-4"><div class="text-center mb-4"><div class="brand">Smart<span class="text-dark">Service</span></div><h2 class="mt-3 mb-1">أنشئ حسابك</h2><p class="text-muted mb-0">انضم إلى منصة الخدمات المحلية</p></div><form asp-controller="Account" asp-action="Register" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="col-md-6 mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger small"></span></div></div><div class="mb-3"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" placeholder="المدينة والعنوان"/></div><div class="mb-3"><label asp-for="ProfileImageFile" class="form-label"></label><input asp-for="ProfileImageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp"/></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control"/><span asp-validation-for="Password" class="text-danger small"></span></div><div class="col-md-6 mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control"/><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div></div><button class="btn btn-primary w-100 py-2" type="submit">إنشاء الحساب</button></form><div class="text-center mt-3 small">لديك حساب؟ <a asp-controller="Account" asp-action="Login">تسجيل الدخول</a></div></div></body></html>
