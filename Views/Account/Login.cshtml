@model SmartServiceManagement.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Service Management</title>
    <!-- استدعاء ملفات Bootstrap والأيقونات وملفات القالب -->
    <link rel="stylesheet" href="~/Admin/assets/css/adminlte.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />


    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            width: 100%;
            max-width: 420px;
            padding: 2.5rem 2rem;
            position: relative;
            overflow: hidden;
        }

            .login-card::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                left: 0;
                height: 5px;
                background: linear-gradient(90deg, #3b82f6, #6366f1);
            }

        .brand-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .brand-icon {
            width: 54px;
            height: 54px;
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .brand-title {
            font-weight: 700;
            color: #0f172a;
            font-size: 1.5rem;
            margin-bottom: 0.25rem;
        }

        .brand-subtitle {
            color: #64748b;
            font-size: 0.875rem;
        }

        .form-label {
            font-weight: 600;
            color: #334155;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
        }

        .input-group-custom {
            position: relative;
        }

            .input-group-custom .form-control {
                border-radius: 10px;
                padding: 0.75rem 1rem 0.75rem 2.5rem;
                border: 1px solid #cbd5e1;
                font-size: 0.925rem;
                transition: all 0.2s ease;
            }

                .input-group-custom .form-control:focus {
                    border-color: #3b82f6;
                    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
                }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 10;
        }

        .btn-submit {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border: none;
            border-radius: 10px;
            padding: 0.75rem;
            font-weight: 600;
            font-size: 1rem;
            color: white;
            transition: all 0.2s ease;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        }

            .btn-submit:hover {
                background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
                transform: translateY(-1px);
                box-shadow: 0 6px 12px -2px rgba(37, 99, 235, 0.3);
            }

        .form-check-input:checked {
            background-color: #2563eb;
            border-color: #2563eb;
        }

        .link-primary-custom {
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

            .link-primary-custom:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand-header">
            <div class="brand-icon">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            <h1 class="brand-title">أهلاً بك مجدداً</h1>
            <p class="brand-subtitle">سجّل الدخول للوصول إلى لوحة التحكم</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-group-custom">
                    <input asp-for="Email" class="form-control" placeholder="اسم المستخدم أو البريد" />
                    <i class="fa-regular fa-envelope input-icon"></i>
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <div class="input-group-custom">
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <i class="fa-solid fa-lock input-icon"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberCheck" />
                    <label asp-for="RememberMe" class="form-check-label small text-secondary" for="rememberCheck"></label>
                </div>
            </div>

            <button type="submit" class="btn btn-submit w-100">
                <i class="fa-solid fa-right-to-bracket ms-2"></i> تسجيل الدخول
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <p class="mb-0 text-secondary small">
                ليس لديك حساب حتى الآن؟
                <a asp-controller="Account" asp-action="Register" class="link-primary-custom">إنشاء حساب جديد</a>
            </p>
        </div>
        <footer class="app-footer">
            <!--begin::To the end-->
            <div class="float-end d-none d-sm-inline">Anything you want</div>
            <!--end::To the end-->
            <!--begin::Copyright-->
            <strong>
                Maymona Team <span> SmartServiceManagement  </span>
            </strong>
            All rights reserved.
            <!--end::Copyright-->
        </footer>
        <!--end::Footer-->
    </div>
</body>
</html>