                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =========================
                 STATS SECTION
            ========================== -->

            <section id="stats"
                     class="stats section">

                <div class="container"
                     data-aos="fade-up"
                     data-aos-delay="100">

                    <div class="row justify-content-center">

                        <div class="col-lg-10">

                            <div class="stats-wrapper">


                                <div class="stats-item"
                                     data-aos="zoom-in"
                                     data-aos-delay="150">

                                    <div class="icon-wrapper">
                                        <i class="bi bi-grid"></i>
                                    </div>

                                    <span data-purecounter-start="0"
                                          data-purecounter-end="@activeServicesCount"
                                          data-purecounter-duration="1"
                                          class="purecounter">
                                    </span>

                                    <p>
                                        Available Services
                                    </p>

                                </div>


                                <div class="stats-item"
                                     data-aos="zoom-in"
                                     data-aos-delay="200">

                                    <div class="icon-wrapper">
                                        <i class="bi bi-building"></i>
                                    </div>

                                    <span data-purecounter-start="0"
                                          data-purecounter-end="@approvedProvidersCount"
                                          data-purecounter-duration="1"
                                          class="purecounter">
                                    </span>

                                    <p>
                                        Approved Providers
                                    </p>

                                </div>


                                <div class="stats-item"
                                     data-aos="zoom-in"
                                     data-aos-delay="250">

                                    <div class="icon-wrapper">
                                        <i class="bi bi-clipboard-check"></i>
                                    </div>

                                    <span data-purecounter-start="0"
                                          data-purecounter-end="@completedRequestsCount"
                                          data-purecounter-duration="1"
                                          class="purecounter">
                                    </span>

                                    <p>
                                        Completed Requests
                                    </p>

                                </div>


                                <div class="stats-item"
                                     data-aos="zoom-in"
                                     data-aos-delay="300">

                                    <div class="icon-wrapper">
                                        <i class="bi bi-people"></i>
                                    </div>

                                    <span data-purecounter-start="0"
                                          data-purecounter-end="@usersCount"
                                          data-purecounter-duration="1"
                                          class="purecounter">
                                    </span>

                                    <p>
                                        Registered Users
                                    </p>

                                </div>


                            </div>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =========================
                 SERVICES SECTION
            ========================== -->

            <section id="services"
                     class="services section">

                <div class="container section-title"
                     data-aos="fade-up">

                    <span class="description-title">
                        Our Services
                    </span>

                    <h2>
                        Available Services
                    </h2>

                    <p>
                        Explore active services currently available
                        through Smart Service Management.
                    </p>

                </div>


                <div class="container"
                     data-aos="fade-up"
                     data-aos-delay="100">


                    <div class="services-header">

                        <div class="row">

                            <div class="col-lg-9"
                                 data-aos="fade-right">

                                <div class="services-intro">

                                    <div class="services-tag">
                                        Service Marketplace
                                    </div>

                                    <h2>
                                        Find The Service You Need
                                    </h2>

                                    <p>
                                        Choose from the services available
                                        on the platform and submit a request
                                        when you find what you need.
                                    </p>

                                    <p>
                                        The services shown below are loaded
                                        directly from the database and only
                                        active services are displayed.
                                    </p>

                                </div>

                            </div>


                            <div class="col-lg-3"
                                 data-aos="fade-left">

                                <div class="services-stats">

                                    <div class="stat-item">

                                        <span class="stat-number">
                                            @activeServicesCount
                                        </span>

                                        <span class="stat-label">
                                            Available Services
                                        </span>

                                    </div>


                                    <div class="stat-item">

                                        <span class="stat-number">
                                            @approvedProvidersCount
                                        </span>

                                        <span class="stat-label">
                                            Service Providers
                                        </span>

                                    </div>


                                    <div class="stat-item">

                                        <span class="stat-number">
                                            @requestsCount
                                        </span>

                                        <span class="stat-label">
                                            Service Requests
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="row g-4">

                        @if (homeServices.Any())
                        {

                            var delay = 100;

                            foreach (var service in homeServices)
                            {

                                <div class="col-lg-3 col-md-6"
                                     data-aos="fade-up"
                                     data-aos-delay="@delay">

                                    <div class="service-card h-100">

                                        <div class="service-card-inner h-100 d-flex flex-column">


                                            @if (!string.IsNullOrWhiteSpace(service.Image))
                                            {

                                                <div class="home-service-media">
                                                    <img src="@service.Image"
                                                         alt="@service.ServiceName"
                                                         loading="lazy">
                                                    <div class="home-media-shade"></div>
                                                    <span class="home-media-label">
                                                        <i class="bi bi-patch-check-fill"></i>
                                                        خدمة متاحة
                                                    </span>
                                                </div>

                                            }
                                            else
                                            {

                                                <div class="home-service-media home-service-placeholder">
                                                    <i class="bi bi-tools"></i>
                                                    <span>Smart Service</span>
                                                </div>

                                            }


                                <h3>
                                    @service.ServiceName
                                </h3>


                                <p class="flex-grow-1">

                                    @(string.IsNullOrWhiteSpace(service.Description)
                                                                        ? "Professional service available through Smart Service Management."
                                                                        : service.Description)

                                </p>


                                @if (service.Price > 0)
                                            {

                                                <p class="mb-2">

                                                    <strong>
                                                        Price:
                                                        @service.Price.ToString("0.00")
                                                    </strong>

                                                </p>

                                            }


                                            <a asp-controller="ServiceRequests"
                                               asp-action="Create"
                                               asp-route-serviceId="@service.ServiceId"
                                               class="btn btn-sm mt-2">

                                                Request Service

                                                <i class="bi bi-arrow-right ms-1"></i>

                                            </a>


                                        </div>

                                    </div>

                                </div>

                                delay += 100;

                            }

                        }
                        else
                        {

                            <div class="col-12 text-center py-5">

                                <i class="bi bi-inbox fs-1"></i>

                                <h4 class="mt-3">
                                    No Services Available
                                </h4>

                                <p>
                                    There are currently no active services
                                    to display.
                                </p>

                            </div>

                        }

                    </div>

                </div>

            </section>


            <!-- =========================
                 FEATURES SECTION
            ========================== -->

            <section id="features"
                     class="features section">


                <div class="container section-title"
                     data-aos="fade-up">

