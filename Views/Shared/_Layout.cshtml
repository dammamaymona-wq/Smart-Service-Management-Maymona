@using Microsoft.EntityFrameworkCore
@using SmartServiceManagement.Data
@using SmartServiceManagement.Models
@using SmartServiceManagement.Models.Enums
@inject ApplicationDbContext _context

@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();
    var areaName = ViewContext.RouteData.Values["area"]?.ToString();

    var isHomePage = string.Equals(controllerName, "Home", StringComparison.OrdinalIgnoreCase)
                     && string.Equals(actionName, "Index", StringComparison.OrdinalIgnoreCase)
                     && string.IsNullOrWhiteSpace(areaName);

    var activeServicesCount = 0;
    var approvedProvidersCount = 0;
    var usersCount = 0;
    var requestsCount = 0;
    var completedRequestsCount = 0;
    var pendingRequestsCount = 0;

    var homeServices = new List<Service>();
    var homeProviders = new List<Provider>();

    if (isHomePage)
    {
        activeServicesCount = await _context.Services
            .AsNoTracking()
            .CountAsync(s => s.IsActive);

        approvedProvidersCount = await _context.Providers
            .AsNoTracking()
            .CountAsync(p => p.Status == ProviderStatus.Approved);

        usersCount = await _context.Users.CountAsync();

        requestsCount = await _context.ServiceRequests
            .AsNoTracking()
            .CountAsync();

        completedRequestsCount = await _context.ServiceRequests
            .AsNoTracking()
            .CountAsync(r => r.Status == RequestStatus.Completed);

        pendingRequestsCount = await _context.ServiceRequests
            .AsNoTracking()
            .CountAsync(r => r.Status == RequestStatus.Pending);

        homeServices = await _context.Services
            .AsNoTracking()
            .Where(s => s.IsActive)
            .OrderByDescending(s => s.ServiceId)
            .Take(8)
            .ToListAsync();

        homeProviders = await _context.Providers
            .AsNoTracking()
            .Where(p => p.Status == ProviderStatus.Approved)
            .OrderByDescending(p => p.ProviderId)
            .Take(6)
            .ToListAsync();
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">

    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>@ViewData["Title"] - Smart Service Management</title>

    <meta name="description"
          content="Smart Service Management is a platform for discovering services, requesting services, connecting customers with providers, and managing service requests.">

    <meta name="keywords"
          content="Smart Service Management, services, providers, service requests, Palestine">

    <!-- Favicons -->
    <link href="~/Admin/assets/img/favicon.png" rel="icon">
    <link href="~/Admin/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">

    <link href="https://fonts.gstatic.com"
          rel="preconnect"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Mukta:wght@200;300;400;500;600;700;800&family=Abel:wght@400&display=swap"
          rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/Admin/assets/vendor/bootstrap/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="~/Admin/assets/vendor/bootstrap-icons/bootstrap-icons.css"
          rel="stylesheet">

    <link href="~/Admin/assets/vendor/aos/aos.css"
          rel="stylesheet">

    <link href="~/Admin/assets/vendor/swiper/swiper-bundle.min.css"
          rel="stylesheet">

    <link href="~/Admin/assets/vendor/glightbox/css/glightbox.min.css"
          rel="stylesheet">

    <!-- Main CSS File -->
    <link href="~/Admin/assets/css/main.css"
          rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)

    <!-- Lighter visual theme and reliable local images -->
    <style>
        :root {
            --background-color: #f7fbff;
            --surface-color: #ffffff;
            --default-color: #52657a;
            --heading-color: #24415f;
            --accent-color: #78aee2;
            --contrast-color: #ffffff;
        }

        body.index-page {
            background-color: #f7fbff;
            color: #52657a;
        }

        .about-section-image,
        .purpose-section-image {
            display: block;
            width: 100%;
            object-fit: cover;
            box-shadow: 0 14px 34px rgba(74, 126, 177, .14);
        }

        .about-section-image {
            height: 210px;
        }

        .purpose-section-image {
            max-height: 260px;
            min-height: 190px;
        }

        .about-visual-card {
            background: linear-gradient(145deg, #ffffff 0%, #eef7ff 100%);
            border-color: #dcecf9 !important;
        }

        .purpose-visual {
            width: 100%;
        }

        .purpose-icon {
            display: block;
            margin-top: 18px;
            color: #78aee2;
            font-size: 54px;
        }

        .cta-image-container {
            background: linear-gradient(145deg, #edf7ff 0%, #dceefe 100%);
        }
    </style>

</head>

<body class="index-page">

    <!-- Header -->
    <header id="header"
            class="header d-flex align-items-center position-relative">

        <div class="container-fluid position-relative d-flex align-items-center justify-content-between">

            <a asp-controller="Home"
               asp-action="Index"
               class="logo d-flex align-items-center">

                <h1 class="sitename">
                    Smart Service Management
                </h1>

            </a>

            <nav id="navmenu"
                 class="navmenu">

                <ul>

                    <li>
                        <a href="/#hero">
                            Home
                        </a>
                    </li>

                    <li>
                        <a href="/#about">
                            About
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Services" asp-action="Index">
                            Services
                        </a>
                    </li>

                    <li>
                        <a href="/#features">
                            Features
                        </a>
                    </li>

                    <li>
                        <a href="/#how-it-works">
                            How It Works
                        </a>
                    </li>

                    <li>
                        <a href="/#faq">
                            FAQ
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Providers" asp-action="Index">
                            Providers
                        </a>
                    </li>

                    <li>
                        <a href="/#contact">
                            Contact
                        </a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-link border-0 bg-transparent">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a asp-controller="Account"
                               asp-action="Login">
                                Login
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Account"
                               asp-action="Register">
                                Register
                            </a>
                        </li>
                    }

                </ul>

                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>

            </nav>

        </div>

    </header>
    <!-- End Header -->


    <main class="main">

        @RenderBody()


        @if (isHomePage)
        {

            <!-- =========================
                 ABOUT SECTION
            ========================== -->

            <section id="about"
                     class="about section">

                <div class="container section-title"
                     data-aos="fade-up">

                    <span class="description-title">
                        About Us
                    </span>

                    <h2>
                        About Smart Service Management
                    </h2>

                    <p>
                        A practical platform that brings customers,
                        service providers, and service management together.
                    </p>

                </div>


                <div class="container"
                     data-aos="fade-up"
                     data-aos-delay="100">

                    <div class="row align-items-center gy-4">

                        <div class="col-lg-6">

                            <div class="about-content">

                                <h3>
                                    One Place For Service Discovery And Management
                                </h3>

                                <p>
                                    Smart Service Management helps customers
                                    find available services, choose what they need,
                                    and submit service requests through an organized
                                    digital platform.
                                </p>

                                <p>
                                    Service providers can apply to join the platform,
                                    present their services, and manage the requests
                                    they receive.
                                </p>

                                <p>
                                    Administrators can manage users,
                                    services, providers, and service requests
                                    through the management system.
                                </p>


                                <div class="row gy-3 mt-3">

                                    <div class="col-md-6">

                                        <div class="d-flex align-items-start gap-3">

                                            <i class="bi bi-search fs-2"></i>

                                            <div>

                                                <h5>
                                                    Find Services
                                                </h5>

                                                <p class="mb-0">
                                                    Browse active services
                                                    available on the platform.
                                                </p>

                                            </div>

                                        </div>

                                    </div>


                                    <div class="col-md-6">

                                        <div class="d-flex align-items-start gap-3">

                                            <i class="bi bi-clipboard-check fs-2"></i>

                                            <div>

                                                <h5>
                                                    Track Requests
                                                </h5>

                                                <p class="mb-0">
                                                    Follow the status of
                                                    submitted service requests.
                                                </p>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="col-lg-6">

                            <div class="p-4 rounded-4 border h-100 about-visual-card">

                                <img src="~/Admin/assets/img/misc/misc-square-13.webp"
                                     alt="About Smart Service Management"
                                     class="img-fluid rounded-4 about-section-image"
                                     loading="lazy">

                                <div class="row g-4 mt-1">

                                    <div class="col-6">

                                        <div class="text-center p-3">

                                            <i class="bi bi-grid fs-1"></i>

                                            <h4 class="mt-3">
                                                @activeServicesCount
                                            </h4>

                                            <p class="mb-0">
                                                Active Services
                                            </p>

                                        </div>

                                    </div>


                                    <div class="col-6">

                                        <div class="text-center p-3">

                                            <i class="bi bi-building fs-1"></i>

                                            <h4 class="mt-3">
                                                @approvedProvidersCount
                                            </h4>

                                            <p class="mb-0">
                                                Approved Providers
                                            </p>

                                        </div>

                                    </div>


                                    <div class="col-6">

                                        <div class="text-center p-3">

                                            <i class="bi bi-people fs-1"></i>

                                            <h4 class="mt-3">
                                                @usersCount
                                            </h4>

                                            <p class="mb-0">
                                                Registered Users
                                            </p>

                                        </div>

                                    </div>


                                    <div class="col-6">

                                        <div class="text-center p-3">

                                            <i class="bi bi-check2-circle fs-1"></i>

                                            <h4 class="mt-3">
                                                @completedRequestsCount
                                            </h4>

                                            <p class="mb-0">
                                                Completed Requests
