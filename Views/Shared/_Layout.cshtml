                             data-aos="fade-right"
                             data-aos-delay="200">

                            <h2>
                                Simple Service Management
                            </h2>

                            <p>
                                Smart Service Management brings
                                the main service activities into one place
                                so users can find services, submit requests,
                                and follow progress more easily.
                            </p>

                            <p>
                                The system also provides role-based management
                                for administrators and service providers.
                            </p>


                            <div class="achievement-badges">


                                <div class="achievement">

                                    <span class="achievement-icon">
                                        <i class="bi bi-shield-check"></i>
                                    </span>

                                    <div class="achievement-info">

                                        <span class="achievement-value">
                                            Organized
                                        </span>

                                        <span class="achievement-label">
                                            User &amp; Service Management
                                        </span>

                                    </div>

                                </div>


                                <div class="achievement">

                                    <span class="achievement-icon">
                                        <i class="bi bi-clock-history"></i>
                                    </span>

                                    <div class="achievement-info">

                                        <span class="achievement-value">
                                            Trackable
                                        </span>

                                        <span class="achievement-label">
                                            Service Request Status
                                        </span>

                                    </div>

                                </div>


                            </div>

                        </div>


                        <div class="features-card-wrapper"
                             data-aos="fade-left"
                             data-aos-delay="300">


                            <div class="features-row">


                                <div class="feature-card feature-primary"
                                     data-aos="zoom-in"
                                     data-aos-delay="200">

                                    <div class="feature-icon">
                                        <i class="bi bi-person-check"></i>
                                    </div>

                                    <div class="feature-details">

                                        <h3>
                                            Customer Accounts
                                        </h3>

                                        <p>
                                            Customers can register,
                                            browse services,
                                            submit requests,
                                            and follow their service activity.
                                        </p>

                                        <div class="feature-status active">

                                            <span class="status-indicator"></span>

                                            <span class="status-text">
                                                Available
                                            </span>

                                        </div>

                                    </div>

                                </div>


                                <div class="feature-card"
                                     data-aos="zoom-in"
                                     data-aos-delay="300">

                                    <div class="feature-icon">
                                        <i class="bi bi-building"></i>
                                    </div>

                                    <div class="feature-details">

                                        <h3>
                                            Provider Management
                                        </h3>

                                        <p>
                                            Providers can apply to join
                                            the platform and manage the
                                            services they offer after approval.
                                        </p>

                                        <div class="feature-status pending">

                                            <span class="status-indicator"></span>

                                            <span class="status-text">
                                                Supported
                                            </span>

                                        </div>

                                    </div>

                                </div>


                            </div>


                            <div class="features-row">


                                <div class="feature-card"
                                     data-aos="zoom-in"
                                     data-aos-delay="400">

                                    <div class="feature-icon">
                                        <i class="bi bi-kanban"></i>
                                    </div>

                                    <div class="feature-details">

                                        <h3>
                                            Service Requests
                                        </h3>

                                        <p>
                                            Service requests move through
                                            the workflow with clear statuses
                                            for the relevant users.
                                        </p>

                                        <div class="feature-status active">

                                            <span class="status-indicator"></span>

                                            <span class="status-text">
                                                Operational
                                            </span>

                                        </div>

                                    </div>

                                </div>


                                <div class="feature-card"
                                     data-aos="zoom-in"
                                     data-aos-delay="500">

                                    <div class="feature-icon">
                                        <i class="bi bi-bell"></i>
                                    </div>

                                    <div class="feature-details">

                                        <h3>
                                            Notifications
                                        </h3>

                                        <p>
                                            Users can receive platform
                                            notifications related to
                                            their service activities
                                            and requests.
                                        </p>

                                        <div class="feature-status scheduled">

                                            <span class="status-indicator"></span>

                                            <span class="status-text">
                                                Supported
                                            </span>

                                        </div>

                                    </div>

                                </div>


                            </div>


                        </div>

                    </div>


                    <div class="additional-features"
                         data-aos="fade-up"
                         data-aos-delay="100">

                        <div class="row gx-4 gy-4">


                            <div class="col-lg-4 col-md-6"
                                 data-aos="fade-up"
                                 data-aos-delay="200">

                                <div class="additional-feature-card">

                                    <div class="icon-container">
                                        <i class="bi bi-search"></i>
                                    </div>

                                    <h4>
                                        Service Discovery
                                    </h4>

                                    <p>
                                        Customers can explore active
                                        services and choose the service
                                        that matches their needs.
                                    </p>

                                    <div class="feature-tag active">
                                        <i class="bi bi-check-circle"></i>
                                        Available
                                    </div>

                                </div>

                            </div>


                            <div class="col-lg-4 col-md-6"
                                 data-aos="fade-up"
                                 data-aos-delay="300">

                                <div class="additional-feature-card">

                                    <div class="icon-container">
                                        <i class="bi bi-clipboard-data"></i>
                                    </div>

                                    <h4>
                                        Request Management
                                    </h4>

                                    <p>
                                        Service requests are stored
                                        and managed through a clear
                                        request workflow.
                                    </p>

                                    <div class="feature-tag active">
                                        <i class="bi bi-check-circle"></i>
                                        Available
                                    </div>

                                </div>

                            </div>


                            <div class="col-lg-4 col-md-6"
                                 data-aos="fade-up"
                                 data-aos-delay="400">

                                <div class="additional-feature-card">

                                    <div class="icon-container">
                                        <i class="bi bi-shield-lock"></i>
                                    </div>

