                                    <li class="nav-item"
                                        role="presentation">

                                        <button class="nav-link active"
                                                data-bs-toggle="pill"
                                                data-bs-target="#general-faq"
                                                type="button">

                                            General

                                        </button>

                                    </li>


                                    <li class="nav-item"
                                        role="presentation">

                                        <button class="nav-link"
                                                data-bs-toggle="pill"
                                                data-bs-target="#customer-faq"
                                                type="button">

                                            Customers

                                        </button>

                                    </li>


                                    <li class="nav-item"
                                        role="presentation">

                                        <button class="nav-link"
                                                data-bs-toggle="pill"
                                                data-bs-target="#provider-faq"
                                                type="button">

                                            Providers

                                        </button>

                                    </li>


                                </ul>


                                <div class="tab-content">


                                    <!-- General -->

                                    <div class="tab-pane fade show active"
                                         id="general-faq"
                                         role="tabpanel">


                                        <div class="accordion"
                                             id="generalAccordion">


                                            <div class="faq-item">

                                                <h3>
                                                    What is Smart Service Management?
                                                </h3>

                                                <div class="faq-content">

                                                    <p>
                                                        It is a platform that connects
                                                        customers with service providers
                                                        and helps manage services and
                                                        service requests in one place.
                                                    </p>

                                                </div>

                                                <i class="bi bi-chevron-down faq-toggle"></i>

                                            </div>


                                            <div class="faq-item">

                                                <h3>
                                                    How do I create an account?
                                                </h3>

                                                <div class="faq-content">

                                                    <p>
                                                        Choose Register from the main
                                                        navigation, complete the required
                                                        information, and submit the
                                                        registration form.
                                                    </p>

                                                </div>

                                                <i class="bi bi-chevron-down faq-toggle"></i>

                                            </div>


                                            <div class="faq-item">

                                                <h3>
                                                    How do I request a service?
                                                </h3>

                                                <div class="faq-content">

                                                    <p>
                                                        Browse the available services,
                                                        select the service you need,
                                                        and use the Request Service
                                                        button to submit your request.
                                                    </p>

                                                </div>

                                                <i class="bi bi-chevron-down faq-toggle"></i>

                                            </div>


                                            <div class="faq-item">

                                                <h3>
                                                    Can I track my service request?
                                                </h3>

                                                <div class="faq-content">

                                                    <p>
                                                        Yes. Your request follows
                                                        the service request workflow
                                                        and its current status can be
                                                        viewed by the relevant user.
                                                    </p>

                                                </div>

                                                <i class="bi bi-chevron-down faq-toggle"></i>

                                            </div>


                                        </div>

                                    </div>


                                    <!-- Customers -->

                                    <div class="tab-pane fade"
                                         id="customer-faq"
                                         role="tabpanel">


                                        <div class="accordion"
                                             id="customerAccordion">


                                            <div class="faq-item">

                                                <h3>
                                                    What can customers do?
                                                </h3>

                                                <div class="faq-content">

                                                    <p>
                                                        Customers can register,
                                                        browse active services,
                                                        submit service requests,
                                                        and follow their request progress.
                                                    </p>

                                                </div>

                                                <i class="bi bi-chevron-down faq-toggle"></i>

                                            </div>


                                            <div class="faq-item">

                                                <h3>
                                                    How do I know the status of my request?
                                                </h3>

                                                <div class="faq-content">

                                                    <p>
                                                        The platform stores the
                                                        request status and displays
                                                        it through the relevant
                                                        request management pages.
                                                    </p>

                                                </div>

                                                <i class="bi bi-chevron-down faq-toggle"></i>

                                            </div>


                                            <div class="faq-item">

                                                <h3>
                                                    Can I receive notifications?
                                                </h3>

                                                <div class="faq-content">

                                                    <p>
                                                        The platform includes
                                                        notifications for users
                                                        so relevant service activity
                                                        can be communicated through
                                                        the system.
                                                    </p>

                                                </div>

                                                <i class="bi bi-chevron-down faq-toggle"></i>

                                            </div>


                                        </div>

                                    </div>


                                    <!-- Providers -->

                                    <div class="tab-pane fade"
                                         id="provider-faq"
                                         role="tabpanel">


                                        <div class="accordion"
                                             id="providerAccordion">


                                            <div class="faq-item">

                                                <h3>
                                                    How can I become a service provider?
                                                </h3>

                                                <div class="faq-content">

                                                    <p>
                                                        Use the Become a Provider
                                                        option and submit the provider
                                                        application. The administrator
                                                        reviews the application before
                                                        approval.
                                                    </p>

                                                </div>

                                                <i class="bi bi-chevron-down faq-toggle"></i>

                                            </div>


                                            <div class="faq-item">

                                                <h3>
                                                    Can providers manage their services?
                                                </h3>

                                                <div class="faq-content">

                                                    <p>
                                                        Approved providers can manage
                                                        the services they offer through
                                                        the provider area of the platform.
                                                    </p>

                                                </div>

                                                <i class="bi bi-chevron-down faq-toggle"></i>

                                            </div>


                                            <div class="faq-item">

                                                <h3>
                                                    Who approves provider applications?
                                                </h3>

                                                <div class="faq-content">

                                                    <p>
                                                        Provider applications are reviewed
                                                        and managed by the administrator
                                                        before the provider becomes
                                                        approved on the platform.
                                                    </p>

                                                </div>

                                                <i class="bi bi-chevron-down faq-toggle"></i>

                                            </div>


                                        </div>

                                    </div>


                                </div>

                            </div>

                        </div>


                    </div>

                </div>

            </section>


            <!-- =========================
                 PROVIDERS SECTION
            ========================== -->

            <section id="team"
                     class="team section">


                <div class="container"
                     data-aos="fade-up"
                     data-aos-delay="100">


                    <div class="team-header"
                         data-aos="fade-up"
                         data-aos-delay="200">


                        <div class="row align-items-center">


                            <div class="col-lg-8">

                                <h2>
                                    Approved Service Providers
                                </h2>

                                <p>
                                    These providers are loaded directly
                                    from the database and only approved
                                    providers are shown.
                                </p>

                            </div>


                            <div class="col-lg-4 d-flex justify-content-lg-end">

                                <a asp-controller="Provider"
                                   asp-action="Apply"
                                   class="btn btn-primary">

                                    Become a Provider

                                </a>

                            </div>


                        </div>

                    </div>


                    <div class="team-slider swiper init-swiper"
                         data-aos="fade-up"
                         data-aos-delay="300">


                        <script type="application/json"
                                class="swiper-config">

                            {
                              "loop": true,
                              "speed": 700,
                              "autoplay": {
                                "delay": 5000
                              },
                              "slidesPerView": 1,
                              "spaceBetween": 30,
                              "navigation": {
                                "nextEl": ".team-next",
                                "prevEl": ".team-prev"
                              },
                              "breakpoints": {
                                "576": {
                                  "slidesPerView": 2,
                                  "spaceBetween": 20
                                },
                                "992": {
                                  "slidesPerView": 3,
                                  "spaceBetween": 30
                                },
                                "1200": {
                                  "slidesPerView": 4,
                                  "spaceBetween": 30
                                }
                              }
                            }

                        </script>


                        <div class="swiper-wrapper">


                            @if (homeProviders.Any())
                            {

                                foreach (var provider in homeProviders)
                                {

                                    <div class="swiper-slide">


                                        <div class="team-member">


                                            <div class="member-image home-provider-media">


                                                @if (!string.IsNullOrWhiteSpace(provider.Logo))
                                                {

                                                    <img src="@provider.Logo"
                                                         alt="@provider.CompanyName"
                                                         loading="lazy">
                                                    <div class="home-media-shade"></div>
                                                    <span class="home-media-label">
                                                        <i class="bi bi-patch-check-fill"></i>
                                                        مزود معتمد
                                                    </span>

                                                }
                                                else
                                                {

                                                    <div class="home-provider-placeholder">
                                                        <i class="bi bi-building"></i>
                                                        <span>مزود معتمد</span>
                                                    </div>

                                                }


                                </div>


                                <div class="member-content">


                                    <h3>
                                        @provider.CompanyName
                                    </h3>


                                    <span>
                                        @provider.City
                                    </span>


                                    <p>
                                        @(string.IsNullOrWhiteSpace(provider.Description)
                                                                                ? "Approved service provider on Smart Service Management."
                                                                                : provider.Description)
                                    </p>


                                    @if (provider.ExperienceYears > 0)
                                                {

                                                    <small>

                                                        <i class="bi bi-award me-1"></i>

                                                        @provider.ExperienceYears years
                                                        of experience

                                                    </small>

                                                }


                                            </div>


                                        </div>


                                    </div>

                                }

                            }
                            else
                            {

                                <div class="swiper-slide">

                                    <div class="team-member">

                                        <div class="member-content text-center">

                                            <i class="bi bi-building-add fs-1"></i>

                                            <h3 class="mt-3">
                                                No Approved Providers Yet
                                            </h3>

                                            <p>
                                                Service providers can apply
                                                to join the platform and offer
                                                their services after approval.
                                            </p>

                                            <a asp-controller="Provider"
                                               asp-action="Apply"
                                               class="btn btn-primary">

                                                Apply Now

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            }


                        </div>


                        <div class="d-flex justify-content-center gap-2 mt-4">

                            <button type="button"
                                    class="team-control-btn team-prev"
                                    aria-label="Previous provider">

                                <i class="bi bi-chevron-left"></i>

                            </button>


                            <button type="button"
                                    class="team-control-btn team-next"
                                    aria-label="Next provider">

                                <i class="bi bi-chevron-right"></i>

                            </button>

                        </div>


                    </div>

                </div>

            </section>


            <!-- =========================
                 CONTACT SECTION
            ========================== -->

            <section id="contact"
                     class="contact section">


                <div class="container section-title"
                     data-aos="fade-up">

                    <span class="description-title">
                        Contact
                    </span>

                    <h2>
                        Contact Smart Service Management
                    </h2>

                    <p>
                        For questions about services,
                        providers, accounts, or service requests,
                        use the available contact option.
                    </p>

                </div>


                <div class="container">


                    <div class="contact-wrapper">


                        <div class="contact-info-panel">


                            <div class="contact-info-header">

                                <h3>
                                    Platform Information
                                </h3>

                                <p>
                                    Smart Service Management provides
                                    one place to discover services
                                    and manage service requests.
                                </p>

                            </div>


                            <div class="contact-info-cards">


                                <div class="info-card">

                                    <div class="icon-container">
                                        <i class="bi bi-pin-map-fill"></i>
                                    </div>

                                    <div class="card-content">

                                        <h4>
                                            Location
                                        </h4>

                                        <p>
                                            Tulkarm, Palestine
                                        </p>

                                    </div>

                                </div>


                                <div class="info-card">

                                    <div class="icon-container">
                                        <i class="bi bi-clock-history"></i>
                                    </div>

                                    <div class="card-content">

                                        <h4>
                                            Working Hours
                                        </h4>

                                        <p>
                                            Sunday - Thursday:
                                            7:00 AM - 6:00 PM
                                        </p>

                                    </div>

                                </div>


                                <div class="info-card">

                                    <div class="icon-container">
                                        <i class="bi bi-grid"></i>
                                    </div>

                                    <div class="card-content">

                                        <h4>
                                            Active Services
                                        </h4>

                                        <p>
                                            @activeServicesCount
                                            services currently available
                                        </p>

                                    </div>

                                </div>


                                <div class="info-card">

                                    <div class="icon-container">
                                        <i class="bi bi-clipboard-check"></i>
                                    </div>

                                    <div class="card-content">

                                        <h4>
                                            Service Requests
                                        </h4>

                                        <p>
                                            @requestsCount
                                            requests recorded on the platform
                                        </p>

                                    </div>

                                </div>


                            </div>


                            <div class="social-links-panel">

                                <h5>
                                    Smart Service Management
                                </h5>

                                <p class="mb-0">
                                    Connect customers, providers,
                                    and service management in one
                                    organized platform.
                                </p>

                            </div>


                        </div>


                        <div class="contact-form-panel">


                            <div class="map-container">

                                <div class="d-flex align-items-center justify-content-center h-100 p-4 text-center">

                                    <div>

                                        <i class="bi bi-geo-alt"
                                           style="font-size:70px;">
                                        </i>

                                        <h4 class="mt-3">
                                            Smart Service Management
                                        </h4>

                                        <p>
                                            Tulkarm, Palestine
                                        </p>

                                    </div>

                                </div>

                            </div>


                            <div class="form-container">

                                <h3>
                                    Need Help?
                                </h3>

                                <p>
                                    For support, account questions,
                                    or service-related questions,
                                    use the platform contact option below.
                                </p>


                                <div class="contact-details mt-4">


                                    <div class="mb-3">

                                        <i class="bi bi-people me-2"></i>

                                        Customers and service providers

                                    </div>


                                    <div class="mb-3">

                                        <i class="bi bi-clipboard-check me-2"></i>

                                        Service request support

                                    </div>


                                    <div>

                                        <i class="bi bi-building me-2"></i>

                                        Provider application support

                                    </div>


                                </div>


                                <div class="d-grid mt-4">

                                    <a href="#faq"
                                       class="btn-submit text-center">

                                        View FAQ

                                        <i class="bi bi-question-circle ms-2"></i>

                                    </a>

                                </div>


                            </div>


                        </div>


                    </div>

                </div>

            </section>

        }

    </main>

    <style>
        .home-service-media,
        .home-provider-media {
            position: relative;
            overflow: hidden;
            min-height: 190px;
            border-radius: 16px;
            background: linear-gradient(135deg, #eaf2ff 0%, #d8e8ff 100%);
        }

            .home-service-media img,
            .home-provider-media img {
                display: block;
                width: 100%;
                height: 100%;
                min-height: 190px;
                object-fit: cover;
                object-position: center;
                transition: transform .45s cubic-bezier(.23, 1, .32, 1), filter .3s ease;
            }

        .service-card:hover .home-service-media img,
        .team-member:hover .home-provider-media img {
            transform: scale(1.06);
            filter: saturate(1.08);
        }

        .home-media-shade {
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: linear-gradient(180deg, rgba(10, 31, 60, .02) 35%, rgba(10, 31, 60, .68) 100%);
        }

        .home-media-label {
            position: absolute;
            right: 14px;
            bottom: 13px;
            z-index: 1;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 10px;
            color: #fff;
            background: rgba(12, 36, 70, .68);
            border: 1px solid rgba(255, 255, 255, .24);
            border-radius: 999px;
            backdrop-filter: blur(7px);
            font-size: 11px;
            font-weight: 700;
        }

            .home-media-label i {
                color: #9fd0ff;
            }

        .home-service-placeholder,
        .home-provider-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 10px;
            min-height: 190px;
            color: #2869b6;
            background: radial-gradient(circle at 25% 20%, #fff 0, transparent 38%), linear-gradient(135deg, #e8f2ff, #cddfff);
        }

            .home-service-placeholder i {
                font-size: 56px;
            }

            .home-service-placeholder span,
            .home-provider-placeholder span {
                color: #47709d;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: .04em;
            }

        .home-provider-media,
        .home-provider-placeholder {
            min-height: 220px;
        }

            .home-provider-media img {
                min-height: 220px;
            }

            .home-provider-placeholder i {
                color: #2869b6;
                font-size: 74px;
            }

        @@media (max-width: 575.98px) {
            .home-service-media,
            .home-provider-media,
            .home-service-placeholder,
            .home-provider-placeholder {
                min-height: 170px;
            }

                .home-service-media img,
                .home-provider-media img {
                    min-height: 170px;
                }
        }

        @@media (prefers-reduced-motion: reduce) {
            .home-service-media img,
            .home-provider-media img {
                transition: none;
            }
        }
    </style>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer id="footer"
            class="footer">


        <div class="container footer-top">


            <div class="row gy-4">


                <div class="col-lg-5 col-md-12 footer-about">


                    <a asp-controller="Home"
                       asp-action="Index"
                       class="logo d-flex align-items-center">

                        <span class="sitename">
                            Smart Service Management
                        </span>

                    </a>


                    <p>
                        Smart Service Management connects customers
                        with service providers and helps organize
                        services and service requests in one place.
                    </p>


                    <div class="social-links d-flex mt-4">


                        <a href="#contact"
                           aria-label="Contact">

                            <i class="bi bi-envelope"></i>

                        </a>


                        <a href="#faq"
                           aria-label="FAQ">

                            <i class="bi bi-question-circle"></i>

                        </a>


                        <a href="#services"
                           aria-label="Services">

                            <i class="bi bi-grid"></i>

                        </a>


                        <a href="#team"
                           aria-label="Providers">

                            <i class="bi bi-building"></i>

                        </a>


                    </div>


                </div>


                <div class="col-lg-2 col-6 footer-links">


                    <h4>
                        Useful Links
                    </h4>


                    <ul>

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li>
                            <a href="/#about">
                                About
                            </a>
                        </li>

                        <li>
                            <a href="/#services">
                                Services
                            </a>
                        </li>

                        <li>
                            <a href="/#how-it-works">
                                How It Works
                            </a>
                        </li>

                        <li>
                            <a href="/#contact">
                                Contact
                            </a>
                        </li>

                    </ul>


                </div>


                <div class="col-lg-2 col-6 footer-links">


                    <h4>
                        Platform
                    </h4>


                    <ul>

                        <li>
                            <a href="/#services">
                                Find Services
                            </a>
                        </li>

                        <li>
                            <a href="/#features">
                                Features
                            </a>
                        </li>

                        <li>
                            <a href="/#faq">
                                FAQ
                            </a>
                        </li>

                        <li>
                            <a href="/#team">
                                Providers
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Provider"
                               asp-action="Apply">
                                Become a Provider
                            </a>
                        </li>

                    </ul>


                </div>


                <div class="col-lg-3 col-md-12 footer-contact text-center text-md-start">


                    <h4>
                        Platform Information
                    </h4>


                    <p>
                        Tulkarm, Palestine
                    </p>

                    <p>
                        Sunday - Thursday
                    </p>

                    <p>
                        7:00 AM - 6:00 PM
                    </p>


                    <p class="mt-4">

                        <strong>
                            Services:
                        </strong>

                        <span>
                            @activeServicesCount active
                        </span>

                    </p>


                    <p>

                        <strong>
                            Providers:
                        </strong>

                        <span>
                            @approvedProvidersCount approved
                        </span>

                    </p>


                </div>


            </div>

        </div>


        <div class="container copyright text-center mt-4">


            <p>

                ©

                <span>
                    Copyright
                </span>

                <strong class="px-1 sitename">
                    Smart Service Management
                </strong>

                <span>
                    All Rights Reserved
                </span>

            </p>


            <div class="credits">

                Smart Service Management Platform

            </div>


        </div>


    </footer>


    <!-- Scroll Top -->

    <a href="#"
       id="scroll-top"
       class="scroll-top d-flex align-items-center justify-content-center">

        <i class="bi bi-arrow-up-short"></i>

    </a>


    <!-- Preloader -->

    <div id="preloader"></div>


    <!-- Vendor JS Files -->

    <script src="~/Admin/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script src="~/Admin/assets/vendor/aos/aos.js"></script>

    <script src="~/Admin/assets/vendor/purecounter/purecounter_vanilla.js"></script>

    <script src="~/Admin/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>

    <script src="~/Admin/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>

    <script src="~/Admin/assets/vendor/swiper/swiper-bundle.min.js"></script>

    <script src="~/Admin/assets/vendor/glightbox/js/glightbox.min.js"></script>


    <!-- Main JS File -->

    <script src="~/Admin/assets/js/main.js"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>



