@model IEnumerable<SmartServiceManagement.Models.Provider>
@{ ViewData["Title"] = "مزودو الخدمة"; }
<div class="container py-5" dir="rtl"><div class="mb-4"><span class="text-primary fw-bold">أشخاص يمكنك الاعتماد عليهم</span><h1>مزودو الخدمة</h1><p class="text-muted">شركاؤنا المعتمدون في مدينتك.</p></div><form method="get" class="row g-2 mb-4"><div class="col-md-9"><input name="city" value="@ViewBag.City" class="form-control" placeholder="ابحث حسب المدينة"/></div><div class="col-md-3"><button class="btn btn-outline-primary w-100">بحث</button></div></form><div class="row g-4">@foreach(var p in Model){<div class="col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="d-flex gap-3 align-items-center">@if(!string.IsNullOrWhiteSpace(p.Logo)){<img src="@p.Logo" style="width:58px;height:58px;object-fit:cover;border-radius:12px"/>}else{<div class="bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center" style="width:58px;height:58px;font-size:24px">@p.CompanyName.Substring(0,1)</div>}<div><h5 class="mb-1">@p.CompanyName</h5><small class="text-muted">@p.City · @p.ExperienceYears سنوات خبرة</small></div></div><p class="text-muted small mt-3">@p.Description</p><div class="d-flex justify-content-between align-items-center"><span class="text-warning">★ @p.AverageRating.ToString("0.0")</span><a asp-action="Details" asp-route-id="@p.ProviderId" class="btn btn-sm btn-outline-primary">عرض الملف</a></div></div></div></div>}@if(!Model.Any()){<div class="col-12"><div class="alert alert-light">لا يوجد مزودون معتمدون حالياً.</div></div>}</div></div>
