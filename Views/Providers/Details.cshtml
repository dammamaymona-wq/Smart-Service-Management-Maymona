@model SmartServiceManagement.Models.Provider
@{ ViewData["Title"] = Model.CompanyName; }
<div class="container py-5" dir="rtl"><div class="card border-0 shadow-sm mb-4"><div class="card-body p-4 d-flex gap-3 align-items-center">@if(!string.IsNullOrWhiteSpace(Model.Logo)){<img src="@Model.Logo" style="width:90px;height:90px;object-fit:cover;border-radius:16px"/>}<div><h1 class="h3">@Model.CompanyName</h1><p class="text-muted mb-1">@Model.City · @Model.ExperienceYears سنوات خبرة · ★ @Model.AverageRating.ToString("0.0")</p><p class="mb-0">@Model.Description</p></div></div></div><h2 class="h4 mb-3">الخدمات التي يقدمها</h2><div class="row g-4">@foreach(var s in Model.Services.Where(s => s.IsActive)){<div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h5>@s.ServiceName</h5><p class="text-muted small">@s.Description</p><strong>@s.Price.ToString("0.00") د.أ</strong><a asp-controller="Services" asp-action="Details" asp-route-id="@s.ServiceId" class="btn btn-sm btn-outline-primary float-start">التفاصيل</a></div></div></div>}</div></div>
