@model SmartServiceManagement.Models.Service
@{ ViewData["Title"] = "إضافة خدمة"; }
<div class="container-fluid p-4" dir="rtl"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="mb-4">إضافة خدمة جديدة</h2><form asp-action="Create" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="ServiceName" class="form-label">اسم الخدمة</label><input asp-for="ServiceName" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="CategoryId" class="form-label">التصنيف</label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">اختر التصنيف</option></select></div><div class="col-md-4 mb-3"><label asp-for="Price" class="form-label">السعر</label><input asp-for="Price" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="EstimatedDuration" class="form-label">المدة بالدقائق</label><input asp-for="EstimatedDuration" class="form-control"/></div><div class="col-md-4 mb-3"><label for="imageFile" class="form-label">صورة الخدمة</label><input id="imageFile" name="imageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp"/></div></div><div class="mb-3"><label asp-for="Description" class="form-label">الوصف</label><textarea asp-for="Description" rows="5" class="form-control"></textarea></div><div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">الخدمة متاحة للحجز</label></div><button class="btn btn-primary">حفظ الخدمة</button><a asp-action="Index" class="btn btn-light me-2">رجوع</a></form></div></div></div>
