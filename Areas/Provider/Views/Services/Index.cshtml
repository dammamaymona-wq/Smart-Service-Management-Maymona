@model IEnumerable<SmartServiceManagement.Models.Service>
@{ ViewData["Title"] = "خدماتي"; }
<div class="container-fluid p-4" dir="rtl"><div class="d-flex justify-content-between mb-4"><div><h2>خدماتي</h2><p class="text-muted">الخدمات المسجلة باسمك في قاعدة البيانات.</p></div><a asp-action="Create" class="btn btn-primary">إضافة خدمة</a></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>الخدمة</th><th>التصنيف</th><th>السعر</th><th>المدة</th><th>الحالة</th><th>إجراء</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.ServiceName</td><td>@item.Category?.CategoryName</td><td>@item.Price.ToString("0.00") د.أ</td><td>@item.EstimatedDuration دقيقة</td><td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "نشطة" : "متوقفة")</span></td><td><form asp-action="ToggleStatus" method="post"><input type="hidden" name="id" value="@item.ServiceId"/><button class="btn btn-sm btn-outline-secondary">@(item.IsActive ? "تعطيل" : "تفعيل")</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="6" class="text-center py-4 text-muted">لم تضف خدمات بعد.</td></tr>}</tbody></table></div></div></div>
