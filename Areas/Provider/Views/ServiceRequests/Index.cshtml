@model IEnumerable<SmartServiceManagement.Models.ServiceRequest>
@using SmartServiceManagement.Models.Enums
@{ ViewData["Title"] = "طلبات الخدمة"; }
<div class="container-fluid p-4" dir="rtl"><h2 class="mb-4">طلبات الخدمة الواردة</h2><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>الخدمة</th><th>العميل</th><th>التاريخ</th><th>الوصف</th><th>الحالة</th><th>تحديث</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Service?.ServiceName</td><td>@item.Customer?.FullName</td><td>@item.RequestDate.ToLocalTime().ToString("yyyy/MM/dd")</td><td>@(item.ProblemDescription ?? "-")</td><td><span class="badge text-bg-secondary">@item.Status</span></td><td><form asp-action="UpdateStatus" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@item.RequestId"/><select name="status" class="form-select form-select-sm"><option value="@RequestStatus.Accepted">قبول</option><option value="@RequestStatus.InProgress">قيد التنفيذ</option><option value="@RequestStatus.Completed">مكتمل</option><option value="@RequestStatus.Rejected">رفض</option></select><button class="btn btn-sm btn-primary">حفظ</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="6" class="text-center py-4 text-muted">لا توجد طلبات حالياً.</td></tr>}</tbody></table></div></div></div>
