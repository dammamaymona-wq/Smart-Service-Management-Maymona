@model SmartServiceManagement.ViewModels.ProviderDashboardViewModel
@{ ViewData["Title"] = "لوحة مزود الخدمة"; }
<div class="container-fluid p-4" dir="rtl"><div class="d-flex justify-content-between align-items-center mb-4"><div><span class="text-primary fw-bold">مساحة مزود الخدمة</span><h2 class="fw-bold mb-1">@Model.Provider.CompanyName</h2><p class="text-muted mb-0">أداؤك وطلباتك الجديدة في مكان واحد.</p></div><a asp-area="Provider" asp-controller="Services" asp-action="Create" class="btn btn-primary">إضافة خدمة</a></div><div class="row g-3 mb-4"><div class="col-md-3"><div class="small-box text-bg-primary"><div class="inner"><h3>@Model.TotalServices</h3><p>الخدمات النشطة</p></div><i class="bi bi-box small-box-icon"></i></div></div><div class="col-md-3"><div class="small-box text-bg-info"><div class="inner"><h3>@Model.TotalRequests</h3><p>إجمالي الطلبات</p></div><i class="bi bi-clipboard small-box-icon"></i></div></div><div class="col-md-3"><div class="small-box text-bg-warning"><div class="inner"><h3>@Model.PendingRequests</h3><p>طلبات جديدة</p></div><i class="bi bi-clock small-box-icon"></i></div></div><div class="col-md-3"><div class="small-box text-bg-success"><div class="inner"><h3>@Model.CompletedRequests</h3><p>طلبات مكتملة</p></div><i class="bi bi-star small-box-icon"></i></div></div></div><div class="card border-0 shadow-sm"><div class="card-header bg-white d-flex justify-content-between"><h5 class="mb-0">آخر الطلبات</h5><a asp-area="Provider" asp-controller="ServiceRequests" asp-action="Index">إدارة الطلبات</a></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>الخدمة</th><th>العميل</th><th>التاريخ</th><th>الحالة</th></tr></thead><tbody>@foreach(var item in Model.RecentRequests){<tr><td>@item.Service?.ServiceName</td><td>@item.Customer?.FullName</td><td>@item.RequestDate.ToLocalTime().ToString("yyyy/MM/dd")</td><td><span class="badge text-bg-secondary">@item.Status</span></td></tr>}@if(!Model.RecentRequests.Any()){<tr><td colspan="4" class="text-center py-4 text-muted">لا توجد طلبات بعد.</td></tr>}</tbody></table></div></div></div>
