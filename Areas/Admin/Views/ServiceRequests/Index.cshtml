
@model IEnumerable<SmartServiceManagement.Models.ServiceRequest>

@{
    ViewData["Title"] = "إدارة طلبات الخدمات";

    var requests = Model?.ToList() ?? new List<SmartServiceManagement.Models.ServiceRequest>();

    int totalRequests = requests.Count;
    int pendingRequests = requests.Count(r => r.Status == SmartServiceManagement.Models.Enums.RequestStatus.Pending);
    int inProgressRequests = requests.Count(r => r.Status == SmartServiceManagement.Models.Enums.RequestStatus.InProgress);
    int completedRequests = requests.Count(r => r.Status == SmartServiceManagement.Models.Enums.RequestStatus.Completed);
}


<div class="content-header">
    <div class="container-fluid">

        <div class="row mb-2 align-items-center">

            <div class="col-sm-6">

                <h1 class="m-0 text-white fw-bold">
                    إدارة طلبات الخدمات
                </h1>

            </div>

        </div>

    </div>
</div>


<section class="content">

    <div class="container-fluid">


        <!-- Statistics -->
        <div class="row mb-3">

            <div class="col-lg-3 col-6">

                <div class="small-box bg-primary">

                    <div class="inner">

                        <h3>@totalRequests</h3>

                        <p>إجمالي الطلبات</p>

                    </div>

                    <div class="icon">
                        <i class="fas fa-list-check"></i>
                    </div>

                </div>

            </div>


            <div class="col-lg-3 col-6">

                <div class="small-box bg-warning">

                    <div class="inner">

                        <h3>@pendingRequests</h3>

                        <p>الطلبات المعلقة</p>

                    </div>

                    <div class="icon">
                        <i class="fas fa-hourglass-half"></i>
                    </div>

                </div>

            </div>


            <div class="col-lg-3 col-6">

                <div class="small-box bg-info">

                    <div class="inner">

                        <h3>@inProgressRequests</h3>

                        <p>قيد التنفيذ</p>

                    </div>

                    <div class="icon">
                        <i class="fas fa-spinner"></i>
                    </div>

                </div>

            </div>


            <div class="col-lg-3 col-6">

                <div class="small-box bg-success">

                    <div class="inner">

                        <h3>@completedRequests</h3>

                        <p>الطلبات المكتملة</p>

                    </div>

                    <div class="icon">
                        <i class="fas fa-circle-check"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm"
                 role="alert">

                <i class="fas fa-check-circle me-2"></i>

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- Requests Card -->
        <div class="card card-outline card-primary shadow-sm">


            <div class="card-header">

                <h3 class="card-title text-white fw-bold">

                    <i class="fas fa-table me-2"></i>

                    جميع طلبات الخدمات

                </h3>

            </div>


            <div class="card-body p-0">


                @if (!requests.Any())
                {
                    <div class="text-center text-muted py-5">

                        <i class="fas fa-inbox fa-3x mb-3"></i>

                        <h5>
                            لا توجد طلبات خدمات
                        </h5>

                        <p class="mb-0">
                            لم يتم تسجيل أي طلب خدمة حتى الآن.
                        </p>

                    </div>
                }
                else
                {

                    <div class="table-responsive">


                        <table class="table table-dark table-hover align-middle mb-0">


                            <thead class="table-secondary text-dark">

                                <tr>

                                    <th style="width: 80px;">
                                        #
                                    </th>

                                    <th>
                                        العميل
                                    </th>

                                    <th>
                                        الخدمة
                                    </th>

                                    <th>
                                        تاريخ الطلب
                                    </th>

                                    <th>
                                        التاريخ المفضل
                                    </th>

                                    <th>
                                        الحالة
                                    </th>

                                    <th class="text-center"
                                        style="width: 300px;">
                                        الإجراءات
                                    </th>

                                </tr>

                            </thead>


                            <tbody>


                                @foreach (var item in requests)
                                {

                                    <tr>


                                        <!-- Request ID -->
                                        <td>

                                            <span class="fw-bold text-primary">
                                                #@item.RequestId
                                            </span>

                                        </td>


                                        <!-- Customer -->
                                        <td>

                                            <div class="d-flex align-items-center">

                                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                                     style="width:40px; height:40px;">

                                                    <i class="fas fa-user"></i>

                                                </div>


                                                <div>

                                                    <div class="fw-bold text-white">

                                                        @(item.Customer?.FullName ?? "غير معروف")

                                                    </div>

                                                    <small class="text-white-50">

                                                        @(item.Customer?.Email ?? "")

                                                    </small>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- Service -->
                                        <td>

                                            <span class="fw-bold text-white">

                                                @(item.Service?.ServiceName ?? "غير معروف")

                                            </span>

                                        </td>


                                        <!-- Request Date -->
                                        <td>

                                            <div class="fw-bold text-white">

                                                @item.RequestDate.ToLocalTime().ToString("dd/MM/yyyy")

                                            </div>

                                            <small class="text-white-50">

                                                @item.RequestDate.ToLocalTime().ToString("hh:mm tt")

                                            </small>

                                        </td>


                                        <!-- Preferred Date -->
                                        <td>

                                            @if (item.PreferredDate.HasValue)
                                            {

                                                <div class="fw-bold text-white">

                                                    @item.PreferredDate.Value.ToLocalTime().ToString("dd/MM/yyyy")

                                                </div>

                                                <small class="text-white-50">

                                                    @item.PreferredDate.Value.ToLocalTime().ToString("hh:mm tt")

                                                </small>

                                            }
                                            else
                                            {

                                                <span class="badge bg-secondary">

                                                    غير محدد

                                                </span>

                                            }

                                        </td>


                                        <!-- Status -->
                                        <td>


                                            @switch (item.Status)
                                            {

                                                case SmartServiceManagement.Models.Enums.RequestStatus.Pending:

                                                    <span class="badge bg-warning text-dark px-3 py-2">

                                                        <i class="fas fa-clock me-1"></i>

                                                        معلقة

                                                    </span>

                                                    break;


                                                case SmartServiceManagement.Models.Enums.RequestStatus.Accepted:

                                                    <span class="badge bg-primary px-3 py-2">

                                                        <i class="fas fa-check me-1"></i>

                                                        مقبولة

                                                    </span>

                                                    break;


                                                case SmartServiceManagement.Models.Enums.RequestStatus.InProgress:

                                                    <span class="badge bg-info text-dark px-3 py-2">

                                                        <i class="fas fa-spinner me-1"></i>

                                                        قيد التنفيذ

                                                    </span>

                                                    break;


                                                case SmartServiceManagement.Models.Enums.RequestStatus.Completed:

                                                    <span class="badge bg-success px-3 py-2">

                                                        <i class="fas fa-circle-check me-1"></i>

                                                        مكتملة

                                                    </span>

                                                    break;


                                                case SmartServiceManagement.Models.Enums.RequestStatus.Cancelled:

                                                    <span class="badge bg-danger px-3 py-2">

                                                        <i class="fas fa-times me-1"></i>

                                                        ملغاة

                                                    </span>

                                                    break;

                                            }


                                        </td>


                                        <!-- Actions -->
                                        <td class="text-center">


                                            <div class="btn-group btn-group-sm"
                                                 role="group">


                                                <!-- Details -->
                                                <a asp-area="Admin"
                                                   asp-controller="ServiceRequests"
                                                   asp-action="Details"
                                                   asp-route-id="@item.RequestId"
                                                   class="btn btn-primary me-1 rounded"
                                                   data-bs-toggle="tooltip"
                                                   title="تفاصيل الطلب">

                                                    <i class="fas fa-eye me-1"></i>

                                                    تفاصيل

                                                </a>


                                                <!-- Edit -->
                                                <a asp-area="Admin"
                                                   asp-controller="ServiceRequests"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.RequestId"
                                                   class="btn btn-warning text-dark me-1 rounded"
                                                   data-bs-toggle="tooltip"
                                                   title="تعديل الحالة">

                                                    <i class="fas fa-edit me-1"></i>

                                                    تعديل

                                                </a>


                                                <!-- Delete -->
                                                <form asp-area="Admin"
                                                      asp-controller="ServiceRequests"
                                                      asp-action="Delete"
                                                      asp-route-id="@item.RequestId"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-danger rounded"
                                                            data-bs-toggle="tooltip"
                                                            title="حذف الطلب"
                                                            onclick="return confirm('هل أنت متأكد من حذف طلب الخدمة؟');">

                                                        <i class="fas fa-trash me-1"></i>

                                                        حذف

                                                    </button>

                                                </form>


                                            </div>

                                        </td>


                                    </tr>

                                }


                            </tbody>

                        </table>


                    </div>

                }

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            var tooltipTriggerList =
                [].slice.call(
                    document.querySelectorAll('[data-bs-toggle="tooltip"]')
                );

            tooltipTriggerList.map(function (tooltipTriggerEl) {

                return new bootstrap.Tooltip(tooltipTriggerEl);

            });

        });

    </script>

}

