@model SmartServiceManagement.ViewModels.ServiceViewModel

@{
    ViewData["Title"] = "تعديل الخدمة";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">تعديل الخدمة</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-warning shadow-sm">
            <div class="card-header">
                <h3 class="card-title">تحديث بيانات الخدمة</h3>
            </div>
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImagePath" />

                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">القسم (Category)</label>
                            <select name="categoryId" class="form-select form-control" asp-items="ViewBag.Categories" required></select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">مزود الخدمة (Provider)</label>
                            <select name="providerId" class="form-select form-control" asp-items="ViewBag.Providers" required></select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">المدة التقديرية (بالدقائق)</label>
                            <input name="estimatedDuration" type="number" class="form-control" value="@ViewBag.EstimatedDuration" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ImageFile" class="form-label">تغيير الصورة</label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="mb-3 p-3 border rounded bg-light">
                            <label class="form-label d-block">الصورة الحالية:</label>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@Model.ImagePath" alt="@Model.Title" class="rounded img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;" />
                                <div class="form-check text-danger ms-3">
                                    <input class="form-check-input" type="checkbox" name="removeExistingImage" value="true" id="removeImageCheck" />
                                    <label class="form-check-label fw-bold" for="removeImageCheck">
                                        حذف الصورة الحالية كلياً
                                    </label>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="IsActive" type="checkbox" id="IsActiveCheck" />
                        <label class="form-check-label" for="IsActiveCheck">
                            الخدمة مفعلة
                        </label>
                    </div>
                </div>

                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-warning text-white">
                        <i class="fas fa-edit me-1"></i> حفظ التعديلات
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}