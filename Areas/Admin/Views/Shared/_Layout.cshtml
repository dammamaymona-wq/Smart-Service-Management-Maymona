                {

                    group: 'shared',

                    handle: '.card-header',

                }
            );


            const cardHeaders =
                document.querySelectorAll(
                    '.connectedSortable .card-header'
                );


            cardHeaders.forEach(
                (cardHeader) => {

                    cardHeader.style.cursor =
                        'move';

                }
            );

        }

    </script>


