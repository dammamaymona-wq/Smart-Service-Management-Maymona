                                                    @:الآن
                                                }
                                                else if (time.TotalMinutes < 60)
                                                {
                                                    @($"{(int)time.TotalMinutes} دقيقة")
                                                }
                                                else if (time.TotalHours < 24)
                                                {
                                                    @($"{(int)time.TotalHours} ساعة")
                                                }
                                                else
