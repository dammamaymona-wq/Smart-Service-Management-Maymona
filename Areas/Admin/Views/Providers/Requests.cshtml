@model IEnumerable<SmartServiceManagement.Models.Provider>

@{
    ViewData["Title"] = "طلبات مزودي الخدمة المعلقة";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid p-4">
    <h2 class="mb-4">طلبات مزودي الخدمة المعلقة (Pending Requests)</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>اسم الشركة / المزود</th>
                            <th>اسم المستخدم</th>
                            <th>رقم التواصل</th>
                            <th>المدينة</th>
                            <th>سنوات الخبرة</th>
                            <th>تاريخ الطلب</th>
                            <th class="text-center">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    لا توجد طلبات معلقة حالياً.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.CompanyName</td>
                                    <td>@(item.User?.UserName ?? item.User?.Email)</td>
                                    <td>@(item.ContactNumber ?? "غير محدد")</td>
                                    <td>@(item.City ?? "غير محدد")</td>
                                    <td>@item.ExperienceYears سنوات</td>
                                    <td>@item.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <!-- قبول -->
                                            <form asp-area="Admin" asp-controller="Providers" asp-action="Approve" asp-route-id="@item.ProviderId" method="post" onsubmit="return confirm('هل أنت تأكد من قبول هذا الطلب؟');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="fas fa-check"></i> قبول
                                                </button>
                                            </form>

                                            <!-- رفض -->
                                            <form asp-area="Admin" asp-controller="Providers" asp-action="Reject" asp-route-id="@item.ProviderId" method="post" onsubmit="return confirm('هل أنت تأكد من رفض هذا الطلب؟');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-times"></i> رفض
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>