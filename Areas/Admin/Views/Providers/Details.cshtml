@model SmartServiceManagement.Models.Provider

@{
    ViewData["Title"] = "تفاصيل مزود الخدمة";
}

<!-- Page Header -->
<div class="mb-4">

    <h2 class="fw-bold mb-1">
        <i class="fas fa-user-tie text-primary me-2"></i>
        تفاصيل مزود الخدمة
    </h2>

    <p class="text-muted mb-0">
        عرض جميع بيانات مزود الخدمة والخدمات التابعة له
    </p>

</div>


<div class="row">

    <!-- Provider Information -->
    <div class="col-lg-5 mb-4">

        <div class="card shadow-sm border-0 h-100">

            <!-- Header -->
            <div class="card-header bg-dark py-3">

                <h5 class="mb-0 text-white fw-bold">

                    <i class="fas fa-id-card me-2"></i>

                    بيانات مزود الخدمة

                </h5>

            </div>


            <div class="card-body">

                <!-- Logo -->
                <div class="text-center mb-4">

                    @if (!string.IsNullOrEmpty(Model.Logo))
                    {
                        <img src="@Model.Logo"
                             alt="@Model.CompanyName"
                             class="rounded-circle shadow-sm"
                             style="width:120px;
                                        height:120px;
                                        object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light
                                        d-flex align-items-center
                                        justify-content-center
                                        mx-auto shadow-sm"
                             style="width:120px;
                                        height:120px;">

                            <i class="fas fa-user-tie fa-3x text-primary"></i>

                        </div>
                    }

                </div>


                <!-- Company Name -->
                <div class="text-center mb-4">

                    <h4 class="fw-bold mb-1">
                        @Model.CompanyName
                    </h4>

                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success">

                            <i class="fas fa-check-circle me-1"></i>

                            متاح

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">

                            <i class="fas fa-times-circle me-1"></i>

                            متوقف

                        </span>
                    }

                </div>


                <!-- Information -->
                <div class="border rounded p-3">

                    <!-- User -->
                    <div class="d-flex justify-content-between
                                align-items-center mb-3">

                        <span class="text-muted">

                            <i class="fas fa-user me-2"></i>

                            المستخدم

                        </span>

                        <span class="fw-bold">

                            @(Model.User?.FullName ?? "غير مرتبط")

                        </span>

                    </div>


                    <!-- Email -->
                    <div class="d-flex justify-content-between
                                align-items-center mb-3">

                        <span class="text-muted">

                            <i class="fas fa-envelope me-2"></i>

                            البريد الإلكتروني

                        </span>

                        <span>

                            @(Model.User?.Email ?? "غير محدد")

                        </span>

                    </div>


                    <!-- Phone -->
                    <div class="d-flex justify-content-between
                                align-items-center mb-3">

                        <span class="text-muted">

                            <i class="fas fa-phone me-2"></i>

                            رقم التواصل

                        </span>

                        <span>

                            @(Model.ContactNumber ?? "غير محدد")

                        </span>

                    </div>


                    <!-- City -->
                    <div class="d-flex justify-content-between
                                align-items-center mb-3">

                        <span class="text-muted">

                            <i class="fas fa-map-marker-alt me-2"></i>

                            المدينة

                        </span>

                        <span>

                            @(Model.City ?? "غير محدد")

                        </span>

                    </div>


                    <!-- Experience -->
                    <div class="d-flex justify-content-between
                                align-items-center mb-3">

                        <span class="text-muted">

                            <i class="fas fa-briefcase me-2"></i>

                            سنوات الخبرة

                        </span>

                        <span class="badge bg-info text-dark">

                            @Model.ExperienceYears سنة

                        </span>

                    </div>


                    <!-- Rating -->
                    <div class="d-flex justify-content-between
                                align-items-center mb-3">

                        <span class="text-muted">

                            <i class="fas fa-star me-2"></i>

                            متوسط التقييم

                        </span>

                        <span class="fw-bold">

                            <i class="fas fa-star text-warning me-1"></i>

                            @Model.AverageRating.ToString("0.0")

                            <small class="text-muted">/ 5</small>

                        </span>

                    </div>


                    <!-- Services Count -->
                    <div class="d-flex justify-content-between
                                align-items-center">

                        <span class="text-muted">

                            <i class="fas fa-tools me-2"></i>

                            عدد الخدمات

                        </span>

                        <span class="badge bg-primary">

                            @(Model.Services?.Count ?? 0)

                        </span>

                    </div>

                </div>


                <!-- Description -->
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="mt-4">

                        <h6 class="fw-bold">

                            <i class="fas fa-align-right text-primary me-2"></i>

                            نبذة عن المزود

                        </h6>

                        <p class="text-muted mb-0">
                            @Model.Description
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- Services -->
    <div class="col-lg-7 mb-4">

        <div class="card shadow-sm border-0 h-100">

            <!-- Header -->
            <div class="card-header bg-dark py-3">

                <div class="d-flex justify-content-between
                            align-items-center">

                    <h5 class="mb-0 text-white fw-bold">

                        <i class="fas fa-tools me-2"></i>

                        خدمات مزود الخدمة

                    </h5>

                    <span class="badge bg-primary">

                        @(Model.Services?.Count ?? 0)

                    </span>

                </div>

            </div>


            <div class="card-body">

                @if (Model.Services != null && Model.Services.Any())
                {
                    <div class="row">

                        @foreach (var service in Model.Services)
                        {
                            <div class="col-md-6 mb-3">

                                <div class="border rounded p-3 h-100">

                                    <div class="d-flex
                                                        align-items-center
                                                        mb-2">

                                        <div class="rounded-circle
                                                            bg-light
                                                            d-flex
                                                            align-items-center
                                                            justify-content-center
                                                            me-2"
                                             style="width:40px;
                                                            height:40px;">

                                            <i class="fas fa-tools
                                                              text-primary"></i>

                                        </div>

                                        <div>

                                            <h6 class="fw-bold mb-0">
                                                @service.ServiceName
                                            </h6>

                                        </div>

                                    </div>


                                    <p class="text-muted small mb-2">

                                        @service.Description

                                    </p>


                                    <div class="d-flex
                                                        justify-content-between">

                                        <span class="fw-bold">

                                            @service.Price.ToString("0.00")

                                        </span>

                                        @if (service.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                نشطة
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                غير نشطة
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="text-center py-5">

                        <i class="fas fa-tools fa-3x
                                      text-muted mb-3"></i>

                        <h6 class="text-muted">
                            لا توجد خدمات
                        </h6>

                        <p class="text-muted mb-0">
                            لا يوجد خدمات مرتبطة بمزود الخدمة.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<!-- Footer Buttons -->

<div class="d-flex justify-content-between mb-4">

    <a asp-action="Index"
       class="btn btn-secondary px-4">

        <i class="fas fa-arrow-right me-1"></i>

        العودة للقائمة

    </a>


    @if (Model.IsAvailable)
    {@if (Model.Status == SmartServiceManagement.Models.Enums.ProviderStatus.Pending)
        {
            <form asp-action="Approve"
                  asp-route-id="@Model.ProviderId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success px-4"
                        onclick="return confirm('هل تريد الموافقة على طلب مزود الخدمة؟');">

                    <i class="fas fa-check me-1"></i>

                    الموافقة على الطلب

                </button>

            </form>
        }
        else if (Model.Status == SmartServiceManagement.Models.Enums.ProviderStatus.Approved)
        {
            @if (Model.IsAvailable)
            {
                <form asp-action="Deactivate"
                      asp-route-id="@Model.ProviderId"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger px-4"
                            onclick="return confirm('هل أنت متأكد من إيقاف مزود الخدمة؟');">

                        <i class="fas fa-ban me-1"></i>

                        إيقاف الحساب

                    </button>

                </form>
            }
            else
            {
                <form asp-action="Activate"
                      asp-route-id="@Model.ProviderId"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success px-4"
                            onclick="return confirm('هل تريد تفعيل مزود الخدمة؟');">

                        <i class="fas fa-check me-1"></i>

                        تفعيل الحساب

                    </button>

                </form>
            }
        }

       

        <!-- Rating Card -->
        <div class="mt-4">

            <div class="card border-0 bg-light">

                <div class="card-body text-center">

                    <i class="fas fa-star text-warning fa-2x mb-2"></i>

                    <h3 class="fw-bold mb-1">
                        @Model.AverageRating.ToString("0.0")
                        <small class="text-muted">/ 5</small>
                    </h3>

                    <p class="text-muted mb-0">
                        متوسط تقييم مزود الخدمة
                    </p>

                </div>

            </div>

        </div>
    }

</div>