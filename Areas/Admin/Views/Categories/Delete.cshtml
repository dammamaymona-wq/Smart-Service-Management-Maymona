@model SmartServiceManagement.Models.Category

@{
    ViewData["Title"] = "حذف القسم";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            <i class="fas fa-trash-alt text-danger me-2"></i>
            حذف القسم
        </h2>

        <p class="text-muted mb-0">
            تأكيد حذف القسم من النظام
        </p>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-7 col-xl-6">

            <div class="card border-0 shadow-sm">

                <!-- Header -->
                <div class="card-header border-0 py-3"
                     style="background-color: #212529;">

                    <h5 class="mb-0 text-white fw-bold">

                        <i class="fas fa-exclamation-triangle text-danger me-2"></i>

                        تأكيد حذف القسم

                    </h5>

                </div>


                <div class="card-body p-4">

                    <!-- Warning -->
                    <div class="alert alert-danger">

                        <div class="d-flex">

                            <i class="fas fa-exclamation-triangle fa-2x me-3"></i>

                            <div>

                                <h6 class="fw-bold">
                                    هل أنت متأكد من حذف هذا القسم؟
                                </h6>

                                <p class="mb-0">
                                    سيتم حذف القسم من النظام.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- Category Information -->
                    <div class="text-center mb-4">

                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="@Model.Image"
                                 alt="@Model.CategoryName"
                                 class="rounded-3 shadow-sm mb-3"
                                 style="width:150px;
                                            height:150px;
                                            object-fit:cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center
                                            justify-content-center
                                            rounded-3
                                            bg-light
                                            text-primary
                                            shadow-sm mx-auto mb-3"
                                 style="width:150px;
                                            height:150px;">

                                <i class="fas fa-layer-group fa-3x"></i>

                            </div>
                        }

                        <h4 class="fw-bold mb-1">
                            @Model.CategoryName
                        </h4>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="text-muted mb-0">
                                @Model.Description
                            </p>
                        }

                    </div>


                    <!-- Information -->
                    <div class="border rounded p-3 mb-4">

                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                <i class="fas fa-tools me-2"></i>
                                عدد الخدمات
                            </span>

                            <span class="badge bg-primary">
                                @(Model.Services?.Count ?? 0)
                            </span>

                        </div>


                        <div class="d-flex justify-content-between">

                            <span class="text-muted">
                                <i class="far fa-calendar-alt me-2"></i>
                                تاريخ الإنشاء
                            </span>

                            <span class="fw-bold">
                                @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                            </span>

                        </div>

                    </div>


                    <!-- Cannot Delete -->
                    @if (Model.Services != null && Model.Services.Any())
                    {
                        <div class="alert alert-warning">

                            <i class="fas fa-ban me-2"></i>

                            <strong>تنبيه:</strong>

                            لا يمكن حذف هذا القسم لأنه يحتوي على
                            خدمات مرتبطة به.

                        </div>
                    }

                </div>


                <!-- Footer -->
                <div class="card-footer bg-white border-0 p-4">

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-secondary px-4">

                            <i class="fas fa-arrow-right me-1"></i>

                            إلغاء

                        </a>


                        @if (Model.Services == null || !Model.Services.Any())
                        {
                            <form asp-action="Delete"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@Model.CategoryId" />

                                <button type="submit"
                                        class="btn btn-danger px-4"
                                        onclick="return confirm('هل أنت متأكد من حذف هذا القسم؟');">

                                    <i class="fas fa-trash-alt me-1"></i>

                                    تأكيد الحذف

                                </button>

                            </form>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-danger px-4"
                                    disabled>

                                <i class="fas fa-ban me-1"></i>

                                لا يمكن الحذف

                            </button>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>