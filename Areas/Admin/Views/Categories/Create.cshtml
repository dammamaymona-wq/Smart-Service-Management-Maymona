@model SmartServiceManagement.Models.Category

@{
    ViewData["Title"] = "إضافة قسم";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            <i class="fas fa-plus-circle text-primary me-2"></i>
            إضافة قسم
        </h2>

        <p class="text-muted mb-0">
            إضافة قسم جديد للخدمات في النظام
        </p>

    </div>


    <!-- Form Card -->
    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card border-0 shadow-sm">

                <!-- Card Header -->
                <div class="card-header border-0 py-3"
                     style="background-color: #212529;">

                    <h5 class="mb-0 text-white fw-bold">

                        <i class="fas fa-layer-group text-primary me-2"></i>

                        بيانات القسم

                    </h5>

                </div>


                <!-- Form -->
                <form asp-action="Create"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="card-body p-4">

                        <!-- Validation -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- Category Name -->
                        <div class="mb-4">

                            <label asp-for="CategoryName"
                                   class="form-label fw-bold">

                                <i class="fas fa-tag text-primary me-1"></i>

                                اسم القسم

                            </label>

                            <input asp-for="CategoryName"
                                   class="form-control"
                                   placeholder="مثال: صيانة أجهزة الحاسوب" />

                            <span asp-validation-for="CategoryName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Description -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-bold">

                                <i class="fas fa-align-right text-primary me-1"></i>

                                وصف القسم

                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="اكتب وصفًا مختصرًا للقسم..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Image -->
                        <div class="mb-4">

                            <label class="form-label fw-bold">

                                <i class="fas fa-image text-primary me-1"></i>

                                صورة القسم

                            </label>

                            <input type="file"
                                   name="imageFile"
                                   class="form-control"
                                   accept="image/*"
                                   id="imageFile" />

                            <small class="text-muted">
                                يمكنك اختيار صورة للقسم من جهازك.
                            </small>

                        </div>


                        <!-- Image Preview -->
                        <div class="text-center mt-3">

                            <img id="imagePreview"
                                 src="#"
                                 alt="معاينة الصورة"
                                 class="rounded-3 shadow-sm d-none"
                                 style="width:180px;
                                        height:180px;
                                        object-fit:cover;" />

                        </div>

                    </div>


                    <!-- Footer -->
                    <div class="card-footer bg-white border-0 p-4">

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-secondary px-4">

                                <i class="fas fa-arrow-right me-1"></i>

                                إلغاء

                            </a>


                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="fas fa-save me-1"></i>

                                حفظ القسم

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.getElementById("imageFile").addEventListener("change", function (event) {

            const file = event.target.files[0];

            const preview = document.getElementById("imagePreview");

            if (file) {

                const reader = new FileReader();

                reader.onload = function (e) {

                    preview.src = e.target.result;

                    preview.classList.remove("d-none");

                };

                reader.readAsDataURL(file);

            }
            else {

                preview.src = "#";

                preview.classList.add("d-none");

            }

        });

    </script>
}