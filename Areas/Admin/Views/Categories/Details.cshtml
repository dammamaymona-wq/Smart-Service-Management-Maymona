@model SmartServiceManagement.Models.Category

@{
    ViewData["Title"] = "تفاصيل القسم";
}

<div class="container-fluid">

    <!-- =========================
         Page Header
    ========================== -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-info-circle text-primary me-2"></i>
                تفاصيل القسم
            </h2>

            <p class="text-muted mb-0">
                عرض معلومات القسم والخدمات التابعة له
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.CategoryId"
               class="btn btn-warning text-white me-2">

                <i class="fas fa-edit me-1"></i>
                تعديل القسم

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="fas fa-arrow-right me-1"></i>
                العودة

            </a>

        </div>

    </div>


    <!-- =========================
         Category Information
    ========================== -->
    <div class="card border-0 shadow-sm mb-4">

        <!-- Card Header -->
        <div class="card-header border-0 py-3"
             style="background-color: #212529;">

            <h5 class="mb-0 text-white fw-bold">

                <i class="fas fa-layer-group text-primary me-2"></i>

                معلومات القسم

            </h5>

        </div>


        <div class="card-body p-4">

            <div class="row align-items-center">

                <!-- Image -->
                <div class="col-md-4 text-center mb-4 mb-md-0">

                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image"
                             alt="@Model.CategoryName"
                             class="rounded-3 shadow"
                             style="width:220px;
                                        height:220px;
                                        object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center
                                        justify-content-center
                                        rounded-3
                                        bg-light
                                        text-primary
                                        shadow-sm mx-auto"
                             style="width:220px;
                                        height:220px;">

                            <i class="fas fa-layer-group fa-4x"></i>

                        </div>
                    }

                </div>


                <!-- Information -->
                <div class="col-md-8">

                    <h3 class="fw-bold mb-3">
                        @Model.CategoryName
                    </h3>


                    <!-- Description -->
                    <div class="mb-4">

                        <h6 class="fw-bold">
                            <i class="fas fa-align-right text-primary me-2"></i>
                            الوصف
                        </h6>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="text-muted mb-0">
                                @Model.Description
                            </p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                لا يوجد وصف لهذا القسم.
                            </p>
                        }

                    </div>


                    <div class="row">

                        <!-- Services Count -->
                        <div class="col-sm-4 mb-3">

                            <div class="border rounded p-3">

                                <small class="text-muted d-block mb-1">
                                    عدد الخدمات
                                </small>

                                <h5 class="fw-bold mb-0">

                                    <i class="fas fa-tools text-info me-1"></i>

                                    @(Model.Services?.Count ?? 0)

                                </h5>

                            </div>

                        </div>

                        <!-- Created At -->
                        <div class="col-sm-4 mb-3">

                            <div class="border rounded p-3">

                                <small class="text-muted d-block mb-1">
                                    تاريخ الإنشاء
                                </small>

                                <h6 class="fw-bold mb-0">

                                    <i class="far fa-calendar-alt text-primary me-1"></i>

                                    @Model.CreatedAt.ToString("dd/MM/yyyy")

                                </h6>

                            </div>

                        </div>


                        <!-- Updated At -->
                        <div class="col-sm-4 mb-3">

                            <div class="border rounded p-3">

                                <small class="text-muted d-block mb-1">
                                    آخر تعديل
                                </small>

                                <h6 class="fw-bold mb-0">

                                    @if (Model.UpdatedAt.HasValue)
                                    {
                                        <span>

                                            <i class="fas fa-history text-warning me-1"></i>

                                            @Model.UpdatedAt.Value.ToString("dd/MM/yyyy")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            لم يتم التعديل
                                        </span>
                                    }

                                </h6>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         Services
    ========================== -->
    <div class="card border-0 shadow-sm">

        <!-- Card Header -->
        <div class="card-header border-0 py-3"
             style="background-color: #212529;">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 text-white fw-bold">

                    <i class="fas fa-tools text-primary me-2"></i>

                    الخدمات التابعة للقسم

                </h5>

                <span class="badge bg-primary px-3 py-2">

                    العدد:
                    @(Model.Services?.Count ?? 0)

                </span>

            </div>

        </div>


        <!-- Services Table -->
        <div class="card-body p-0">

            @if (Model.Services != null && Model.Services.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="text-center"
                                    style="width:60px;">
                                    #
                                </th>

                                <th>
                                    اسم الخدمة
                                </th>

                                <th class="text-center">
                                    السعر
                                </th>

                                <th class="text-center">
                                    مدة الخدمة
                                </th>

                                <th class="text-center">
                                    الحالة
                                </th>

                                <th class="text-center"
                                    style="width:80px;">
                                    الإجراء
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int counter = 1;
                            }

                            @foreach (var service in Model.Services)
                            {
                                <tr>

                                    <!-- Number -->
                                    <td class="text-center fw-bold text-muted">
                                        @counter
                                    </td>


                                    <!-- Service Name -->
                                    <td>

                                        <div class="fw-bold">
                                            @service.ServiceName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(service.Description))
                                        {
                                            <small class="text-muted">

                                                @(service.Description.Length > 60
                                                                                    ? service.Description.Substring(0, 60) + "..."
                                                                                    : service.Description)

                                </small>
                                                                }

                                    </td>


                                    <!-- Price -->
                                    <td class="text-center">

                                        <span class="badge bg-success px-3 py-2">

                                            @service.Price.ToString("0.00")

                                        </span>

                                    </td>


                                    <!-- Duration -->
                                    <td class="text-center">

                                        <span>

                                            <i class="far fa-clock text-primary me-1"></i>

                                            @service.EstimatedDuration

                                        </span>

                                    </td>


                                    <!-- Status -->
                                    <td class="text-center">

                                        @if (service.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i>
                                                نشطة
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-times me-1"></i>
                                                غير نشطة
                                            </span>
                                        }

                                    </td>


                                    <!-- Action -->
                                    <td class="text-center">

                                        <a asp-controller="Services"
                                           asp-action="Details"
                                           asp-route-id="@service.ServiceId"
                                           class="btn btn-sm btn-info text-white"
                                           title="عرض الخدمة">

                                            <i class="fas fa-eye"></i>

                                        </a>

                                    </td>

                                </tr>

                                counter++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty Services -->

                <div class="text-center py-5">

                    <i class="fas fa-tools fa-3x text-muted mb-3"></i>

                    <h5 class="text-muted">
                        لا توجد خدمات في هذا القسم
                    </h5>

                    <p class="text-muted mb-0">
                        لم تتم إضافة أي خدمات لهذا القسم حتى الآن.
                    </p>

                </div>
            }

        </div>

    </div>

</div>