@model SmartServiceManagement.Areas.Identity.Models.ApplicationUser

@{
    ViewData["Title"] = "تعديل بيانات المستخدم";

    var profileImage = string.IsNullOrWhiteSpace(Model?.ProfileImage)
        ? Url.Content("~/dist/assets/img/user2-160x160.jpg")
        : Url.Content(Model.ProfileImage);
}

<div class="edit-user-page" dir="rtl">
    <div class="container-fluid px-3 px-md-4 px-xl-5 py-4">

        <!-- Breadcrumb -->
        <div class="edit-breadcrumb mb-4">
            <a asp-action="Index">
                <i class="bi bi-people"></i>
                إدارة المستخدمين
            </a>

            <i class="bi bi-chevron-left"></i>

            <span>تعديل بيانات المستخدم</span>
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-xl-8 col-lg-9">

                <!-- Page Header -->
                <div class="page-heading mb-4">
                    <div>
                        <h1>
                            تعديل بيانات المستخدم
                        </h1>

                        <p>
                            قم بتحديث البيانات الشخصية والصورة الخاصة بالمستخدم.
                        </p>
                    </div>

                    <span class="edit-badge">
                        <i class="bi bi-pencil-square"></i>
                        وضع التعديل
                    </span>
                </div>

                <!-- Main Card -->
                <div class="edit-user-card">

                    <!-- Card Header -->
                    <div class="edit-card-header">
                        <div class="header-icon">
                            <i class="bi bi-person-gear"></i>
                        </div>

                        <div>
                            <span>
                                إدارة الحساب
                            </span>

                            <h2>
                                تحديث معلومات المستخدم
                            </h2>
                        </div>
                    </div>

                    <!-- Form -->
                    <form asp-action="Edit"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <div class="edit-card-body">

                            <!-- Validation -->
                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger validation-summary"
                                 role="alert">
                            </div>

                            <!-- Profile Image -->
                            <div class="profile-upload-section">
                                <img id="profileImagePreview"
                                     src="@profileImage"
                                     alt="صورة المستخدم"
                                     class="profile-preview" />

                                <div class="profile-upload-content">
                                    <h3>
                                        الصورة الشخصية
                                    </h3>

                                    <p>
                                        اختر صورة جديدة لتحديث الصورة الحالية.
                                    </p>

                                    <label for="ProfileImageFile"
                                           class="choose-image-btn">

                                        <i class="bi bi-camera"></i>
                                        اختيار صورة جديدة
                                    </label>

                                    <input type="file"
                                           id="ProfileImageFile"
                                           name="ProfileImageFile"
                                           class="d-none"
                                           accept=".jpg,.jpeg,.png,.webp,image/*" />

                                    <small id="selectedFileName"
                                           class="selected-file-name">
                                        لم يتم اختيار صورة جديدة
                                    </small>
                                </div>
                            </div>

                            <div class="form-divider"></div>

                            <!-- User Information -->
                            <div class="section-heading">
                                <span class="section-icon">
                                    <i class="bi bi-person-vcard"></i>
                                </span>

                                <div>
                                    <h3>
                                        المعلومات الشخصية
                                    </h3>

                                    <p>
                                        حدّث بيانات المستخدم الأساسية.
                                    </p>
                                </div>
                            </div>

                            <div class="row g-4">

                                <!-- Full Name -->
                                <div class="col-12">
                                    <label asp-for="FullName"
                                           class="custom-label">

                                        <i class="bi bi-person"></i>
                                        الاسم الكامل
                                    </label>

                                    <input asp-for="FullName"
                                           class="form-control custom-input"
                                           placeholder="أدخل الاسم الكامل" />

                                    <span asp-validation-for="FullName"
                                          class="text-danger validation-message">
                                    </span>
                                </div>

                                <!-- Email -->
                                <div class="col-md-6">
                                    <label asp-for="Email"
                                           class="custom-label">

                                        <i class="bi bi-envelope"></i>
                                        البريد الإلكتروني
                                    </label>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control custom-input"
                                           placeholder="example@email.com"
                                           dir="ltr" />

                                    <span asp-validation-for="Email"
                                          class="text-danger validation-message">
                                    </span>
                                </div>

                                <!-- Phone -->
                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber"
                                           class="custom-label">

                                        <i class="bi bi-telephone"></i>
                                        رقم الهاتف
                                    </label>

                                    <input asp-for="PhoneNumber"
                                           class="form-control custom-input"
                                           placeholder="أدخل رقم الهاتف"
                                           inputmode="tel"
                                           dir="ltr" />

                                    <span asp-validation-for="PhoneNumber"
                                          class="text-danger validation-message">
                                    </span>
                                </div>

                            </div>

                        </div>

                        <!-- Footer -->
                        <div class="edit-card-footer">

                            <a asp-action="Index"
                               class="cancel-btn">

                                <i class="bi bi-arrow-right"></i>
                                إلغاء والعودة
                            </a>

                            <button type="submit"
                                    class="save-btn">

                                <i class="bi bi-check2-circle"></i>
                                حفظ التغييرات
                            </button>

                        </div>

                    </form>
                </div>

                <p class="page-note">
                    تأكد من صحة البيانات قبل الضغط على زر حفظ التغييرات.
                </p>

            </div>
        </div>

    </div>
</div>

<style>
    .edit-user-page {
        min-height: 100vh;
        background: radial-gradient( circle at top right, rgba(13, 110, 253, .08), transparent 30% ), linear-gradient(180deg, #f8fbff 0%, #f4f7fb 100%);
        color: #172b4d;
    }

    .edit-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #94a3b8;
        font-size: 12px;
    }

        .edit-breadcrumb a {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #64748b;
            text-decoration: none;
            transition: color .2s ease;
        }

            .edit-breadcrumb a:hover {
                color: #0d6efd;
            }

        .edit-breadcrumb > i {
            color: #b7c0ce;
            font-size: 10px;
        }

    .page-heading {
