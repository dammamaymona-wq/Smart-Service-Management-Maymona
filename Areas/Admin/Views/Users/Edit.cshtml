        gap: 16px;
        flex-wrap: wrap;
    }

        .page-heading h1 {
            margin: 0 0 6px;
            color: #172b4d;
            font-size: clamp(25px, 4vw, 32px);
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .page-heading p {
            margin: 0;
            color: #718096;
            font-size: 13px;
        }

    .edit-badge {
        display: inline-flex;
        align-items: center;
