    }

    .form-divider {
        height: 1px;
        margin: 30px 0;
        background: #edf1f5;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 22px;
    }

    .section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        color: #0d6efd;
        background: #eaf2ff;
        font-size: 16px;
    }

    .section-heading h3 {
        margin: 0 0 4px;
        color: #172b4d;
        font-size: 16px;
        font-weight: 800;
    }

    .section-heading p {
        margin: 0;
        color: #8a96a8;
        font-size: 11px;
    }

    .custom-label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: #293b55;
        font-size: 13px;
        font-weight: 700;
    }

        .custom-label i {
            width: 16px;
            color: #0d6efd;
            text-align: center;
        }

    .custom-input {
        min-height: 46px;
        border: 1px solid #dce3ec;
        border-radius: 10px;
        padding: 10px 14px;
        color: #293b55;
        background: #fbfcfe;
        font-size: 13px;
        transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

        .custom-input::placeholder {
            color: #a7b1bf;
        }

        .custom-input:focus {
            border-color: #86b7fe;
